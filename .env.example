# ╔══════════════════════════════════════════════════════════════╗
# ║  Rallly Self-Hosted Configuration                           ║
# ╚══════════════════════════════════════════════════════════════╝
# Run ./rallly.sh setup to generate a .env file interactively,
# or copy this file to .env and fill in the values manually.

# ── Domain & SSL ────────────────────────────────────────────────
# The domain where Rallly will be accessible (e.g. rallly.example.com)
DOMAIN=

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=

# ── App Settings ────────────────────────────────────────────────
# A random secret key used to encrypt sessions (min 32 characters)
# Generate one with: openssl rand -base64 32
SECRET_PASSWORD=change-me-to-random

# Email address shown to users for support inquiries
SUPPORT_EMAIL=

# Email address used as the sender for system emails (optional)
# Falls back to SUPPORT_EMAIL if not set
# NOREPLY_EMAIL=

# ── SMTP (required for sending emails) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PWD=
# Leave false for STARTTLS (587, default) or plain (25, 2525).
# Set to true only for implicit TLS (port 465).
SMTP_SECURE=false

# ── Access Control (optional) ──────────────────────────────────
# Comma-separated list of allowed email addresses or patterns.
# Supports wildcards: "*@example.com" allows all users from that domain.
# Leave empty to allow all emails.
# ALLOWED_EMAILS=

# Email address for the initial admin account (optional)
# INITIAL_ADMIN_EMAIL=

# ── OIDC Single Sign-On (optional) ─────────────────────────────
# OIDC_NAME=OpenID Connect
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Advanced ────────────────────────────────────────────────────
# Override the Rallly Docker image (default: lukevella/rallly:4)
# RALLLY_IMAGE=lukevella/rallly:4
