# ╔══════════════════════════════════════════════════════════════╗
# ║  Rallly Self-Hosted Configuration                           ║
# ╚══════════════════════════════════════════════════════════════╝
# Run ./rallly.sh setup to generate a .env file interactively,
# or copy this file to .env and fill in the values manually.

# ── Domain & SSL ────────────────────────────────────────────────
# The domain where Rallly will be accessible (e.g. rallly.example.com)
DOMAIN=

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=

# Public URL Rallly builds links against. Defaults to https://$DOMAIN — set
# it only to change the scheme, e.g. when running locally without TLS:
#   PROXY_MODE=external
#   WEB_PORT=127.0.0.1:3000
#   DOMAIN=localhost:3000
#   NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=

# ── App Settings ────────────────────────────────────────────────
# A random secret key used to encrypt sessions (min 32 characters)
# Generate one with: openssl rand -base64 32
SECRET_PASSWORD=change-me-to-random

# Email address shown to users for support inquiries
SUPPORT_EMAIL=

# Email address used as the sender for system emails (optional)
# Falls back to SUPPORT_EMAIL if not set
# NOREPLY_EMAIL=

# ── SMTP (required for sending emails) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PWD=
# Leave false for STARTTLS (587, default) or plain (25, 2525).
# Set to true only for implicit TLS (port 465).
SMTP_SECURE=false

# ── Access Control (optional) ──────────────────────────────────
# Comma-separated list of allowed email addresses or patterns.
# Supports wildcards: "*@example.com" allows all users from that domain.
# Leave empty to allow all emails.
# ALLOWED_EMAILS=

# Email address for the initial admin account (optional)
# INITIAL_ADMIN_EMAIL=

# ── OIDC Single Sign-On (optional) ─────────────────────────────
# OIDC_NAME=OpenID Connect
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Advanced ────────────────────────────────────────────────────
# Override the Rallly Docker image (default: lukevella/rallly:4)
# RALLLY_IMAGE=lukevella/rallly:4

# Path on the host to a custom root CA certificate in PEM format. Only
# needed if your network intercepts TLS with a corporate root CA. Mounted
# into the web container and trusted in addition to the built-in roots.
# Read once at startup — run ./rallly.sh restart after changing the file.
# CA_CERT_FILE=/etc/ssl/certs/corporate-root-ca.pem

# Bundled PostgreSQL major version. Managed automatically by rallly.sh:
# set to 18 on fresh installs, or pinned to the version of an existing
# data volume. To move an older install to 18, run ./rallly.sh upgrade-db.
# Only set these manually if you know what you are doing — they must match
# the version and layout your data volume was initialized with.
# POSTGRES_VERSION=18
# POSTGRES_DATA_MOUNT=/var/lib/postgresql
# POSTGRES_VOLUME=db-data
